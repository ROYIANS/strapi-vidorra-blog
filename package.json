{
  "name": "strapi-vidorra-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Modern blog system built with Next.js + Strapi CMS",
  "author": {
    "name": "ROYIANS",
    "email": "royians@vidorra.life",
    "url": "https://www.royians.cn"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:strapi": "pnpm --filter strapi develop",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "build:strapi": "pnpm --filter strapi build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm --recursive exec rm -rf node_modules .turbo dist .next build",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "catalog": {
      "@types/node": "^20.11.0",
      "typescript": "^5.3.0",
      "prettier": "^3.2.0",
      "eslint": "^8.56.0",
      "turbo": "^1.12.0",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "next": "^14.1.0",
      "tailwindcss": "^3.4.0",
      "autoprefixer": "^10.4.0",
      "postcss": "^8.4.0",
      "zustand": "^4.5.0",
      "@tanstack/react-query": "^5.20.0",
      "zod": "^3.22.0"
    }
  }
}