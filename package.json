{
  "name": "vidorra-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Modern blog system built with Next.js + NestJS API",
  "author": {
    "name": "ROYIANS",
    "email": "royians@vidorra.life",
    "url": "https://www.royians.cn"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "build:server": "pnpm --filter server build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm --recursive exec rm -rf node_modules .turbo dist .next build",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
